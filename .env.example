# Copy to .env and fill in. Never commit .env.
# ---- Database ----
# Local dev without Docker uses SQLite. Docker Compose overrides this with PostgreSQL.
# DATABASE_URL=sqlite:////absolute/path/to/app.db   (default: data/app.db in the repo)
POSTGRES_USER=stocks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stocks

# ---- API / CORS ----
CORS_ORIGINS=http://localhost:5173
DASHBOARD_URL=http://localhost:5173

# ---- Market data (free) ----
# Yahoo Finance via yfinance needs no key. Delays and freshness are provider-dependent.
YAHOO_ENABLED=true
# Optional Alpha Vantage free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_LIMIT=25
ALPHA_VANTAGE_PER_MINUTE_LIMIT=5

# ---- Scheduler ----
SCHEDULER_ENABLED=true
REFRESH_INTERVAL_SECONDS=300
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
STALE_AFTER_MINUTES=30

# ---- Ollama (local LLM, optional) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=90

# ---- Telegram (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_COOLDOWN_MINUTES=60

# ---- Paper trading ----
PAPER_STARTING_CAPITAL=1000000
